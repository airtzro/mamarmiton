# Copy to .env (never commit .env: it holds the DuckDNS token)

# your DuckDNS name, without .duckdns.org
DUCKDNS_SUBDOMAIN=mamarmiton-exemple
DOMAIN=mamarmiton-exemple.duckdns.org
# from https://www.duckdns.org after signing in
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000

# where recipes and photos live on the NAS (an OMV shared folder)
DATA_DIR=/srv/dev-disk-by-uuid-XXXX/mamarmiton
# owner of DATA_DIR: `id <user>` on the NAS
PUID=1000
PGID=100

# NAS port that the router's public 443 is forwarded to
HTTPS_PORT=8443
TZ=Europe/Paris

# Import automatique (photo / PDF / Word / text -> recipe). Everything runs on the NAS:
# no account, no key, nothing sent elsewhere. All optional; defaults shown.
# The local model file (same as the desktop app's), for a finer reading than the rules;
# empty = $DATA_DIR/models/qwen2.5-1.5b-instruct-q4_0.gguf. Without the file the import still works.
#IMPORT_MODEL_PATH=
# 0 = build the image without the model's library (smaller image, rules only)
#IMPORT_WITH_LLM=1
# all files of one import together, in MB (the Caddyfile allows up to 31)
#IMPORT_MAX_MB=30
# imports per account per day, and for the whole server per day
#IMPORT_DAILY=40
#IMPORT_DAILY_ALL=300
# one import gives up after this many seconds (slow NAS: OCR of a long scan)
#IMPORT_TIMEOUT_S=240
