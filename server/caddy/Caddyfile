{$DOMAIN} {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}

	# photos are at most 15 MB; refuse anything bigger before it reaches the app.
	# The import takes up to 30 MB of files at once (IMPORT_MAX_MB); raise 32MB here if you raise that.
	@import path /import/recipe
	request_body @import {
		max_size 32MB
	}
	@not_import not path /import/recipe
	request_body @not_import {
		max_size 20MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:8000

	log {
		output stdout
		format console
	}
}
